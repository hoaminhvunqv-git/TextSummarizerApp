# Copy file này thành .env rồi điền giá trị thật. KHÔNG điền key vào file này.

# ===== AI (Gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_SUMMARIZE=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=15
GEMINI_QUIZ_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRY=1

# ===== Bảo mật =====
ENCRYPTION_KEY=
JWT_SECRET=

# ===== Chống spam theo IP =====
RATE_LIMIT_PER_MINUTE=30
RATELIMIT_ENABLED=1
RATELIMIT_STORAGE_URI=memory://

# ===== Cơ sở dữ liệu (Giai đoạn 2) =====
DATABASE_URL=

# ===== Gửi email OTP (Giai đoạn 4) =====
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TextSummarizer AI